load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "grep_matcher",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "grep_matcher",
    crate_features = ["pcre2"],
    deps = [
        "//crates/pcre2:grep_pcre2",
        "//crates/regex:grep_regex",
        "@crate_index//:log",
    ],
)
