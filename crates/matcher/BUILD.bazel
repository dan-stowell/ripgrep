load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "grep_matcher",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/grep-printer:grep_printer",
        "@crate_index//:bstr",
        "@crate_index//:fnv",
        "@crate_index//:log",
        "@crate_index//:regex",
        "@crate_index//:thiserror",
    ],
)
