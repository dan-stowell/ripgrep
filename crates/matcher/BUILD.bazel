load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "grep_matcher",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    deps = [
        "@crate_index//:memchr",
        "@crate_index//:regex_automata",
        "@crate_index//:regex",
        "@crate_index//:bstr",
        "@crate_index//:aho_corasick",
    ],
    proc_macro_deps = [],
    # Add common feature flags that might be needed
    rustc_flags = [
        "--cfg=feature=\"std\"",
        "--cfg=feature=\"perf-literal\"",
        "--cfg=feature=\"perf-literal-multisubstring\"",
        "--cfg=feature=\"perf-literal-substring\"",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "tests",
    srcs = glob(["tests/**/*.rs"]),
    deps = [
        ":grep_matcher",
        ":testutil",
        "@crate_index//:regex",
        "@crate_index//:bstr",
        "@crate_index//:aho_corasick",
        "@crate_index//:regex_automata",
        "@crate_index//:regex_syntax",
    ],
)
rust_library(
    name = "testutil",
    srcs = ["tests/util.rs"],
    deps = [
        ":grep_matcher",
        # Add dependencies that are used in the test utilities
        "@crate_index//:regex",
    ],
    visibility = ["//tests:__subpackages__"],
)
