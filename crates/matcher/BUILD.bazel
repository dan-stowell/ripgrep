load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
  
rust_library(
    name = "grep_matcher",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/tests/**/*.rs"],
    ),
    crate_root = "src/lib.rs",
    crate_name = "grep-matcher",
    edition = "2021",
    deps = [
        "@crate_index//:aho-corasick",
        "@crate_index//:bstr",
        "@crate_index//:memchr",
        "@crate_index//:regex-automata",
    ],
    visibility = ["//visibility:public"],
)
  
rust_test(
    name = "grep_matcher_test",
    srcs = glob(["tests/**/*.rs"]),
    deps = [":grep_matcher", "@crate_index//:regex"],
)
