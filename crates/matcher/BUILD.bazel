load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "grep_matcher",
    srcs = ["src/lib.rs"],
    edition = "2021",
    crate_root = "src/lib.rs",
    deps = [
        "@crate_index//:bstr",
        "@crate_index//:log",
        "@crate_index//:memchr",
        "@crate_index//:regex-automata",
        "@crate_index//:regex-syntax",
    ],
)

rust_test(
    name = "grep_matcher_test",
    srcs = glob(["tests/**/*.rs"]),
    deps = [
        ":grep_matcher",
        "@crate_index//:bstr",
    ],
)
