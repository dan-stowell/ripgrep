load("@rules_rust//rust:defs.bzl", "rust_library")
load("@crate_index//:defs.bzl", "crate_dep")

rust_library(
    name = "grep_matcher",
    srcs = [
        "src/lib.rs",
        "src/candidate.rs",
        "src/matcher.rs",
        "src/noerror.rs",
        "src/utf8.rs",
    ],
    crate = crate_dep(
        name = "grep-matcher",
        repo = "crate_index",
