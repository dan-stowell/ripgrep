load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test", "rust_doc", "rust_clippy", "rustfmt_test")

rust_library(
    name = "grep-regex",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "@ripgrep_deps//:bstr",
        "@ripgrep_deps//:log",
        "@ripgrep_deps//:regex-automata",
        "@ripgrep_deps//:regex-syntax",
        "//crates/matcher:grep-matcher",
    ],
)

rust_test(
    name = "grep-regex_test",
    crate = ":grep-regex",
    edition = "2021",
)

rustfmt_test(
    name = "grep-regex_rustfmt_test",
    targets = [":grep-regex"],
)

rust_clippy(
    name = "grep-regex_clippy",
    deps = [":grep-regex"],
)

rust_doc(
    name = "grep-regex_doc",
    crate = ":grep-regex",
)

# Export Cargo.toml for crate_universe
exports_files(["Cargo.toml"])