load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test", "rust_doc", "rust_clippy", "rustfmt_test")

rust_library(
    name = "grep-searcher",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "@ripgrep_deps//:bstr",
        "@ripgrep_deps//:encoding_rs",
        "@ripgrep_deps//:encoding_rs_io",
        "@ripgrep_deps//:log",
        "@ripgrep_deps//:memchr",
        "@ripgrep_deps//:memmap2-0.9.4",
        "//crates/matcher:grep-matcher",
    ],
    aliases = {
        "@ripgrep_deps//:memmap2-0.9.4": "memmap",
    },
)

rust_test(
    name = "grep-searcher_test",
    crate = ":grep-searcher",
    edition = "2021",
    deps = [
        "//crates/regex:grep-regex",
        "@ripgrep_deps//:regex",
    ],
)

rustfmt_test(
    name = "grep-searcher_rustfmt_test",
    targets = [":grep-searcher"],
)

rust_clippy(
    name = "grep-searcher_clippy",
    deps = [":grep-searcher"],
)

rust_doc(
    name = "grep-searcher_doc",
    crate = ":grep-searcher",
)

# Export Cargo.toml for crate_universe
exports_files(["Cargo.toml"])