load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "grep_matcher",
    crate = "grep-matcher",
    srcs = [
        "src/lib.rs",
        "src/interpolate.rs",
    ],
    crate_root = "src/lib.rs",
    deps = [
        "@crate_index//:memchr",
        "@crate_index//:regex-automata",
        "@crate_index//:aho-corasick",
        "@crate_index//:log",
    ],
    proc_macro_deps = [],
    edition = "2021",
    rust_version = "1.88",
    visibility = ["//visibility:public"],
)

rust_test(
    name = "tests",
    srcs = glob(["tests/**/*.rs"]),
    crate = "tests",
    deps = [
        ":grep_matcher",
        ":testutil",
        "@crate_index//:regex",
    ],
    edition = "2021",
    rust_version = "1.88",
)
rust_library(
    name = "testutil",
    srcs = ["tests/util.rs"],
    crate = "testutil",
    deps = [
        ":grep_matcher",
        "@crate_index//:regex",
    ],
    edition = "2021",
    rust_version = "1.88",
    visibility = ["//tests:__subpackages__"],
)
