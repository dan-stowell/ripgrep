load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "grep_matcher",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "grep_matcher",
    edition = "2021",
    crate_features = ["std"],
    deps = [
        "@crate_index//:memchr",
    ],
)

rust_test(
    name = "grep_matcher_test",
    srcs = glob(["tests/**/*.rs"]),
    crate = ":grep_matcher",
    crate_root = "tests/tests.rs",
    deps = [
        "@crate_index//:regex",
    ],
)
