load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
  
rust_library(
    name = "grep_matcher",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/tests/**/*.rs"],
    ),
    crate_root = "src/lib.rs",
    crate_name = "grep-matcher",
    edition = "2021",
    deps = ["@crate_index//:bstr"],
    visibility = ["//visibility:public"],
)
  
rust_test(
    name = "grep_matcher_test",
    crate = ":grep_matcher",
    srcs = glob(["tests/**/*.rs"]),
    deps = ["@crate_index//:regex"],
)
