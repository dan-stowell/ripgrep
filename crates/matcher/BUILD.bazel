load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "grep_matcher",
    crate = "grep-matcher",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["tests/**/*.rs"],
    ),
    crate_root = "src/lib.rs",
    deps = [
        "@crate_index//:memchr2",
    ],
    proc_macro_deps = [],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "tests",
    srcs = glob(["tests/**/*.rs"]),
    deps = [
        ":grep_matcher",
        ":testutil",
        "@crate_index//:regex",
    ],
)
rust_library(
    name = "testutil",
    srcs = ["tests/util.rs"],
    deps = [
        ":grep_matcher",
        "@crate_index//:regex",
    ],
    visibility = ["//tests:__subpackages__"],
)
