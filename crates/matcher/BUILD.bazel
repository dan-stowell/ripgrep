load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "grep_matcher",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "grep_matcher",
    edition = "2021",
    deps = [
        "@crate_index//:aho-corasick",
        "@crate_index//:bstr",
        "@crate_index//:memchr",
        "@crate_index//:regex",
        "@crate_index//:regex-syntax",
    ],
)

rust_test(
    name = "tests",
    crate = ":grep_matcher",
    deps = [
        "@crate_index//:bstr",
    ],
)

rust_test(
    name = "integration_test",
    crate = ":grep_matcher",
    deps = [
        "@crate_index//:bstr",
    ],
)
