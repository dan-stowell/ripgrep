load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "grep_matcher",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "grep_matcher",
    deps = ["@crate_index//:memchr"],
)

rust_test(
    name = "integration_test",
    srcs = glob(["tests/**/*.rs"]),
    crate_root = "tests/tests.rs",
    deps = [
        ":grep_matcher",
        "@crate_index//:regex",
    ],
)
