load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "grep_matcher",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "@crate_index//:regex",
        "@crate_index//:regex-syntax",
        "@crate_index//:memchr",
    ],
)

rust_test(
    name = "integration_test",
    crate = ":grep_matcher",
)
