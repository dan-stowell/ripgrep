load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "grep_matcher",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "grep_matcher",
    edition = "2021",
    deps = [
        "@crate_index//aho-corasick",
        "@crate_index//log",
        "@crate_index//memchr",
        "@crate_index//regex-automata",
        "@crate_index//regex-syntax",
        "@crate_index//regex",
        "@crate_index//anyhow",
    ],
)

rust_library(
    name = "util",
    srcs = ["tests/util.rs"],
    crate_name = "grep_matcher_test_util",
    edition = "2021",
    deps = [
        ":grep_matcher",
        "@crate_index//regex",
    ],
)

rust_test(
    name = "grep_matcher_test",
    crate = ":grep_matcher",
    srcs = glob(["tests/**/*.rs"], exclude = ["tests/util.rs"]),
    edition = "2021",
    deps = [
        ":util",
        "@crate_index//bstr",
    ],
)
