load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test", "rust_doc", "rust_clippy", "rustfmt_test")

rust_library(
    name = "grep",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/cli:grep-cli",
        "//crates/matcher:grep-matcher",
        "//crates/printer:grep-printer",
        "//crates/regex:grep-regex",
        "//crates/searcher:grep-searcher",
    ],
)

rust_library(
    name = "grep_pcre2",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    crate_features = ["pcre2"],
    edition = "2021",
    visibility = ["//visibility:public"], 
    deps = [
        "//crates/cli:grep-cli",
        "//crates/matcher:grep-matcher",
        "//crates/pcre2:grep-pcre2",
        "//crates/printer:grep-printer",
        "//crates/regex:grep-regex",
        "//crates/searcher:grep-searcher",
    ],
)

rust_test(
    name = "grep_test",
    crate = ":grep",
    edition = "2021",
    deps = [
        "@ripgrep_deps//:termcolor",
        "@ripgrep_deps//:walkdir",
    ],
)

rust_test(
    name = "grep_pcre2_test",
    crate = ":grep_pcre2",
    edition = "2021",
    deps = [
        "@ripgrep_deps//:termcolor",
        "@ripgrep_deps//:walkdir",
    ],
)

rustfmt_test(
    name = "grep_rustfmt_test",
    targets = [":grep"],
)

rust_clippy(
    name = "grep_clippy",
    deps = [":grep"],
)

rust_doc(
    name = "grep_doc",
    crate = ":grep",
)

rustfmt_test(
    name = "grep_pcre2_rustfmt_test",
    targets = [":grep_pcre2"],
)

rust_clippy(
    name = "grep_pcre2_clippy",
    deps = [":grep_pcre2"],
)

rust_doc(
    name = "grep_pcre2_doc",
    crate = ":grep_pcre2",
)

# Export Cargo.toml for crate_universe
exports_files(["Cargo.toml"])