load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "grep_matcher",
    crate = "grep-matcher",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["tests/**/*.rs"],
    ),
    crate_root = "src/lib.rs",
    deps = [
        "@crate_index//:memchr",
        "@crate_index//:regex-automata",
        "@crate_index//:regex",
        "@crate_index//:bstr",
        "@crate_index//:aho-corasick",
        "@crate_index//:log",
    ],
    proc_macro_deps = [],
    crate_features = [
        "std",
        "perf-literal",
        "perf-literal-multisubstring",
        "perf-literal-substring",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "tests",
    srcs = glob(["tests/**/*.rs"]),
    deps = [
        ":grep_matcher",
        ":testutil",
        "@crate_index//:regex",
        "@crate_index//:bstr",
        "@crate_index//:aho_corasick",
        "@crate_index//:regex_automata",
        "@crate_index//:regex_syntax",
    ],
)
rust_library(
    name = "testutil",
    srcs = ["tests/util.rs"],
    deps = [
        ":grep_matcher",
        "@crate_index//:regex",
        "@crate_index//:bstr",
        "@crate_index//:regex_automata",
        "@crate_index//:regex_syntax",
        "@crate_index//:aho_corasick",
    ],
    visibility = ["//tests:__subpackages__"],
)
