load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "grep_matcher",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "@crate_index//:memchr",
        "@crate_index//:regex",
        "@crate_index//:bstr",
        "@crate_index//:lazy_static",
        "@crate_index//:log",
        "@crate_index//:cfg-if",
        "@crate_index//:aho_corasick",
        "@crate_index//:regex-automata",
    ],
    proc_macro_deps = [],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "tests",
    srcs = glob(["tests/**/*.rs"]),
    deps = [
        ":grep_matcher",
        ":testutil",
        "@crate_index//:regex",
        "@crate_index//:bstr",
        "@crate_index//:aho_corasick",
        "@crate_index//:regex-automata",
        "@crate_index//:regex-syntax",
    ],
)
rust_library(
    name = "testutil",
    srcs = ["tests/util.rs"],
    deps = [
        ":grep_matcher",
        "@crate_index//:regex",
        "@crate_index//:bstr",
        "@crate_index//:aho_corasick",
        "@crate_index//:regex-automata",
        "@crate_index//:regex-syntax",
    ],
    visibility = ["//tests:__subpackages__"],
)
