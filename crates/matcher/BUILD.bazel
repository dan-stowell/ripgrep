load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "grep_matcher",
    srcs = glob(["src/**/*.rs", "src/*.rs"]),
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = [
        "@crate_index//:memchr",
    ],
)

rust_test(
    name = "integration_test",
    srcs = glob(["tests/*.rs", "tests/**/*.rs"]),
    crate_root = "tests/tests.rs",
    edition = "2021",
    deps = [
        ":grep_matcher",
        "@crate_index//:regex",
    ],
)
